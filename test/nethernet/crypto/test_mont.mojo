def test_derived_constants_n384() raises:
    var f = _modulus[6](
        "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973"
    )
    assert_equal(f.m0_inv, 0x6ED46089E88FDC45)
    assert_equal(
        _hex(f.one),
        "000000000000000000000000000000000000000000000000389cb27e0bc8d220a7e5f24db74f58851313e695333ad68d",
    )
    assert_equal(
        _hex(f.rr),
        "0c84ee012b39bf213fb05b7a28266895d40d49174aab1cc5bc3e483afcb82947ff3d81e5df1aa4192d319b2419b409a9",
    )
    assert_equal(
        _hex(f.m_minus_2),
        "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52971",
    )
    # The precomputed-constants constructor gives the same value.
    var g = Modulus[6](modulus=f.m, m0_inv=f.m0_inv, one=f.one, rr=f.rr)
    assert_equal(_hex(g.m), _hex(f.m))
    assert_equal(_hex(g.m_minus_2), _hex(f.m_minus_2))
    assert_equal(_hex(g.mul(f.rr, f.rr)), _hex(f.mul(f.rr, f.rr)))


