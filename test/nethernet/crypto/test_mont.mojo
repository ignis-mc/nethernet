def test_bytes_conversion() raises:
    var a = _limbs[4](
        "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    )
    assert_equal(a[0], 0x18191A1B1C1D1E1F)
    assert_equal(a[1], 0x1011121314151617)
    assert_equal(a[2], 0x08090A0B0C0D0E0F)
    assert_equal(a[3], 0x0001020304050607)
    assert_equal(
        _hex(a),
        "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
    )
    # Short input is left-padded; long input keeps its low bytes.
    var short = _limbs[4]("0102030405060708090a")
    assert_equal(short[0], 0x030405060708090A)
    assert_equal(short[1], 0x0102)
    assert_equal(short[2], 0)
    assert_equal(short[3], 0)
    var long = _limbs[4](
        "ffee000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    )
    assert_equal(_hex(long), _hex(a))
    var empty = List[UInt8]()
    assert_true(ct_is_zero(limbs_from_be_bytes[6](Span(empty))) != 0)
    var six = _limbs[6](
        "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7"
    )
    assert_equal(six[5], 0xAA87CA22BE8B0537)
    assert_equal(six[0], 0x3A545E3872760AB7)
    assert_equal(
        _hex(six),
        "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7",
    )


def test_constant_time_predicates() raises:
    assert_equal(ct_word_eq(0, 0), _ONES)
    assert_equal(ct_word_eq(7, 7), _ONES)
    assert_equal(ct_word_eq(_ONES, _ONES), _ONES)
    assert_equal(ct_word_eq(0, 1), 0)
    assert_equal(ct_word_eq(1 << 63, 0), 0)
    assert_equal(ct_word_eq(_ONES, 0), 0)
    var zero = Array[UInt64, 4](fill=0)
    assert_equal(ct_is_zero(zero), _ONES)
    assert_equal(ct_eq(zero, zero), _ONES)
    assert_equal(ct_lt(zero, zero), 0)
    for i in range(4):
        # A single bit anywhere makes the value non-zero and larger.
        var low = Array[UInt64, 4](fill=0)
        low[i] = 1
        var high = Array[UInt64, 4](fill=0)
        high[i] = 1 << 63
        assert_equal(ct_is_zero(low), 0)
        assert_equal(ct_is_zero(high), 0)
        assert_equal(ct_eq(low, high), 0)
        assert_equal(ct_eq(high, high), _ONES)
        assert_equal(ct_lt(zero, low), _ONES)
        assert_equal(ct_lt(low, zero), 0)
        assert_equal(ct_lt(low, high), _ONES)
        assert_equal(ct_lt(high, low), 0)
        assert_equal(ct_lt(high, high), 0)
    # The most significant limb decides, whatever the lower limbs say.
    var a: Array[UInt64, 4] = [_ONES, _ONES, _ONES, 1]
    var b: Array[UInt64, 4] = [0, 0, 0, 2]
    assert_equal(ct_lt(a, b), _ONES)
    assert_equal(ct_lt(b, a), 0)
    # A borrow has to ripple through equal limbs.
    var c: Array[UInt64, 4] = [5, 9, 9, 9]
    var d: Array[UInt64, 4] = [6, 9, 9, 9]
    assert_equal(ct_lt(c, d), _ONES)
    assert_equal(ct_lt(d, c), 0)


def test_constant_time_select_and_swap() raises:
    var a: Array[UInt64, 4] = [1, 2, 3, _ONES]
    var b: Array[UInt64, 4] = [_ONES, 7, 0, 9]
    assert_equal(_hex(ct_select(_ONES, a, b)), _hex(a))
    assert_equal(_hex(ct_select(0, a, b)), _hex(b))
    var x = a.copy()
    var y = b.copy()
    ct_swap(0, x, y)
    assert_equal(_hex(x), _hex(a))
    assert_equal(_hex(y), _hex(b))
    ct_swap(_ONES, x, y)
    assert_equal(_hex(x), _hex(b))
    assert_equal(_hex(y), _hex(a))
    assert_false(ct_eq(x, y) != 0)


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
