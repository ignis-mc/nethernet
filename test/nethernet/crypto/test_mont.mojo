def test_derived_constants_n256() raises:
    var f = _modulus[4](
        "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"
    )
    assert_equal(f.m0_inv, 0xCCD1C8AAEE00BC4F)
    assert_equal(
        _hex(f.one),
        "00000000ffffffff00000000000000004319055258e8617b0c46353d039cdaaf",
    )
    assert_equal(
        _hex(f.rr),
        "66e12d94f3d956202845b2392b6bec594699799c49bd6fa683244c95be79eea2",
    )
    assert_equal(
        _hex(f.m_minus_2),
        "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254f",
    )
    # The precomputed-constants constructor gives the same value.
    var g = Modulus[4](modulus=f.m, m0_inv=f.m0_inv, one=f.one, rr=f.rr)
    assert_equal(_hex(g.m), _hex(f.m))
    assert_equal(_hex(g.m_minus_2), _hex(f.m_minus_2))
    assert_equal(_hex(g.mul(f.rr, f.rr)), _hex(f.mul(f.rr, f.rr)))


