from nethernet.crypto.mont import (
    Modulus,
    ct_eq,
    ct_is_zero,
    ct_lt,
    ct_select,
    ct_swap,
    ct_word_eq,
    limbs_from_be_bytes,
    limbs_reduce_be_bytes,
    limbs_to_be_bytes,
)
from nethernet.wire import hex_decode, hex_encode
from std.testing import TestSuite, assert_equal, assert_false, assert_true

comptime _ONES = UInt64(0xFFFF_FFFF_FFFF_FFFF)


def _limbs[n: Int](text: StringSpan) raises -> Array[UInt64, n]:
    var bytes = hex_decode(text)
    return limbs_from_be_bytes[n](Span(bytes))


def _hex[n: Int](a: Array[UInt64, n]) -> String:
    var bytes = limbs_to_be_bytes(a)
    return hex_encode(Span(bytes))


def _modulus[n: Int](text: StringSpan) raises -> Modulus[n]:
    return Modulus[n](_limbs[n](text))


def _check_ops[
    n: Int
](
    modulus: StringSpan,
    a_hex: StringSpan,
    b_hex: StringSpan,
    sum: StringSpan,
    difference: StringSpan,
    product: StringSpan,
    montgomery_product: StringSpan,
    inverse: StringSpan,
) raises:
    # Expected values were computed with Python integers.
    var f = _modulus[n](modulus)
    var a = _limbs[n](a_hex)
    var b = _limbs[n](b_hex)
    assert_equal(_hex(f.add(a, b)), sum)
    assert_equal(_hex(f.add(b, a)), sum)
    assert_equal(_hex(f.sub(a, b)), difference)
    assert_equal(_hex(f.neg(f.sub(b, a))), difference)
    assert_equal(_hex(f.mul(a, b)), montgomery_product)
    var am = f.to_mont(a)
    var bm = f.to_mont(b)
    assert_equal(_hex(f.from_mont(am)), a_hex)
    assert_equal(_hex(f.from_mont(f.mul(am, bm))), product)
    assert_equal(_hex(f.from_mont(f.mul(bm, am))), product)
    assert_equal(_hex(f.from_mont(f.inv(am))), inverse)
    assert_equal(_hex(f.square(am)), _hex(f.mul(am, am)))
    # a * a^-1 is one unless a is zero.
    var unit = f.mul(am, f.inv(am))
    if ct_is_zero(a) == 0:
        assert_equal(_hex(unit), _hex(f.one))
    else:
        assert_true(ct_is_zero(unit) != 0)


def test_derived_constants_p256() raises:
    var f = _modulus[4](
        "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"
    )
    assert_equal(f.m0_inv, 0x0000000000000001)
    assert_equal(
        _hex(f.one),
        "00000000fffffffeffffffffffffffffffffffff000000000000000000000001",
    )
    assert_equal(
        _hex(f.rr),
        "00000004fffffffdfffffffffffffffefffffffbffffffff0000000000000003",
    )
    assert_equal(
        _hex(f.m_minus_2),
        "ffffffff00000001000000000000000000000000fffffffffffffffffffffffd",
    )
    # The precomputed-constants constructor gives the same value.
    var g = Modulus[4](modulus=f.m, m0_inv=f.m0_inv, one=f.one, rr=f.rr)
    assert_equal(_hex(g.m), _hex(f.m))
    assert_equal(_hex(g.m_minus_2), _hex(f.m_minus_2))
    assert_equal(_hex(g.mul(f.rr, f.rr)), _hex(f.mul(f.rr, f.rr)))


