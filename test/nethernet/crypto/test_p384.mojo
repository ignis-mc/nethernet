    )
    # tcId 515: point with coordinate x = 2
    assert_equal(
        _ecdh_hex(
            "c1781d86cac2c052b7e4f48cef415c5c133052f4e504397e75e4d7cd0ca149da0b4988b8a6ded5ceae4b580691376187",
